def reconcile_stale(name):
 latest=BASE/(name+'-latest.json');failure=BASE/(name+'-last-error.json')
 service=subprocess.run(['systemctl','is-active','--quiet','elasticpc-'+name],capture_output=True)
 if service.returncode not in (3,4):return False
 lock=os.open(RUN/(name+'.lock'),os.O_CREAT|os.O_RDWR,0o600)
 try:
  try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except BlockingIOError:return False
  if any(x.is_mount() for x in BASE.glob(name+'-*/store')):return False
  state=json.loads(latest.read_text()) if latest.exists() else {}
  if state:
   session=Path(state.get('session',''))
   if session.parent!=BASE or not session.name.startswith(name+'-'):raise RuntimeError('Invalid stale session path')
   try:qmp(session/'qmp.sock','query-status')
   except (OSError,ValueError,RuntimeError):pass
   else:return False
   pid=state.get('pid')
   if pid:
    try:
     args=(Path('/proc')/str(pid)/'cmdline').read_bytes()
     if b'qemu-system' in args and str(session/'qmp.sock').encode() in args:return False
    except FileNotFoundError:pass
   current=Path('/proc/sys/kernel/random/boot_id').read_text().strip()
   if state.get('boot_id')==current:return False
   if state.get('status') in ('starting','running','saving','save-failed','paused-space-limit','io-error','guest-panicked'):
    atomic(session/('pre-reconcile-'+uuid.uuid4().hex[:8]+'.json'),state)
    state.update(status='interrupted',pid=None,reconciled_from_previous_boot=True)
    if state.get('mode')=='trial' and state.get('archive')!='saved':state['archive']='incomplete'
    atomic(session/'state.json',state);atomic(latest,state)
  # Prior-boot errors must not shadow a new startup; retain the evidence as history.
  if failure.exists():
   error=json.loads(failure.read_text())
   uptime=float(Path('/proc/uptime').read_text().split()[0])
   if error.get('time',0)<time.time()-uptime:failure.rename(BASE/(name+'-error-history-'+uuid.uuid4().hex[:8]+'.json'))
  return True
 finally:os.close(lock)


