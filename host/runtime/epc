  pid=state.get('pid')
  if pid:
   try:
    args=(Path('/proc')/str(pid)/'cmdline').read_bytes()
    if b'qemu-system' in args and str(session/'qmp.sock').encode() in args:raise RuntimeError('Guest process still exists')
   except FileNotFoundError:pass
  discard_ram(session,state);atomic(session/'state.json',state);atomic(BASE/(state['os']+'-latest.json'),state)
  print('RAM trial discarded; no archive saved.')
