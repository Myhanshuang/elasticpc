def rescue_present():
 devices=[(read(p/'device/name') or '',str((p/'device').resolve())) for p in (SYS/'class/input').glob('event*')]
 return any('keyboard' in n.lower() and '/i8042/' in d for n,d in devices) and any('touchpad' in n.lower() and '/i2c-' in d for n,d in devices)
def peripheral_ids(epc,sock):
 return {x['name'] for x in epc['qmp'](sock,'qom-list',{'path':'/machine/peripheral'})}
def restore_hid(devices):
 for d in devices:
  p=SYS/'bus/usb/devices'/d['port']
  if not p.exists():continue
  if read(p/'idVendor')!=d['vid'] or read(p/'idProduct')!=d['product_id']:raise RuntimeError('USB port identity changed')
  if d['serial'] and read(p/'serial')!=d['serial']:raise RuntimeError('USB serial changed')
  for name in d['interfaces']:
   interface=SYS/'bus/usb/devices'/name
   if not interface.exists():continue
   if read(interface/'bInterfaceClass') not in ('01','03'):raise RuntimeError('Interface changed')
   old=d.get('interface_drivers',{}).get(name,'usbhid')
   if old is None:continue
   if old not in ('usbhid','snd-usb-audio'):raise RuntimeError('Unexpected original USB driver: '+old)
   if not (interface/'driver').exists():(SYS/'bus/usb/drivers'/old/'bind').write_text(name)
   if (interface/'driver').resolve().name!=old:raise RuntimeError('Host USB driver not restored: '+name)
def lease_path(guest):
