 existing=json.loads(lease_path(guest).read_text()) if lease_path(guest).exists() else None
 if existing is not None and (existing.get('session')!=state.get('session') or existing.get('state')!='assigned' or existing.get('deleting')):raise RuntimeError('Existing/pending input lease; release it first')
 session=Path(state['session'])
 if session.parent!=BASE or not session.name.startswith(guest+'-'):raise RuntimeError('Invalid Guest session')
 sock=session/'qmp.sock'
 if epc['qmp'](sock,'query-status').get('status')!='running':raise RuntimeError('Windows not executing')
 devices=select(discover(),names);ids=peripheral_ids(epc,sock)
 other=lease_path('manjaro' if guest=='windows' else 'windows')
 if other.exists():
  occupied=json.loads(other.read_text()).get('devices',[])
  if any(d['port']==x['port'] for d in devices for x in occupied):raise RuntimeError('Device leased to another Guest; release it there first')
 if existing and any(d['id']==x['id'] or d.get('port') and d.get('port')==x.get('port') for d in devices for x in existing['devices']):raise RuntimeError('Device already assigned')
 if any(d['id'] in ids for d in devices):raise RuntimeError('Untracked input device already attached')
 lease={'guest':guest,'session':str(session),'pid':state.get('pid'),'devices':(existing['devices'] if existing else [])+devices,'state':'assigning'}
 epc['atomic'](lease_path(lease.get('guest','windows')),lease)
 try:
  for d in devices:
   props={'driver':'usb-host','id':d['id'],'hostbus':d['hostbus'],'hostaddr':d['hostaddr'],'vendorid':int(d['vid'],16),'productid':int(d['product_id'],16)}
   if no_guest_reset:props['guest-reset']=False;props['guest-resets-all']=False
   epc['qmp'](sock,'device_add',props)
  # One bounded settle interval, then verify physical attachment, not just QOM object creation.
  time.sleep(3)
  for d in devices:
   if not attachment(epc,sock,d):raise RuntimeError('USB device exists in QEMU but is not attached: '+d['name'])
  lease['physical_attachment_verified']=True
  lease['guest_input_verified']=False
  lease['no_guest_reset']=no_guest_reset
  lease['state']='assigned';epc['atomic'](lease_path(lease.get('guest','windows')),lease)
 except Exception as error:
  epc['atomic'](session/'device-last-error.json',{'error':str(error),'devices':[d['selector'] for d in devices]})
  try:
   if release(epc,lease,[d['selector'] for d in devices]) and existing:
    lease['state']='assigned';epc['atomic'](lease_path(lease.get('guest','windows')),lease)
  except Exception:pass
  raise
def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('action',choices=['list','give','release','status']);p.add_argument('guest',nargs='?',type=lambda x:'manjaro' if x=='linux' else x,choices=['windows','manjaro'],default='windows');p.add_argument('devices',nargs='*',help='Exact names from list; use name@port for duplicate names');p.add_argument('--no-guest-reset',action='store_true',help='Compatibility experiment: prevent Guest USB reset commands');p.add_argument('--json',action='store_true',help='Machine-readable device list');a=p.parse_args()
 if a.action=='list':
  devices=discover();rescue=rescue_present()
  if a.json:print(json.dumps({'devices':devices,'laptop_rescue_input':rescue},indent=2,ensure_ascii=False))
  else:
   for d in devices:
    print(('READY   ' if d['eligible'] else 'BLOCKED ')+json.dumps(d['name'],ensure_ascii=False)+'  '+json.dumps(d['selector'],ensure_ascii=False))
   print('Laptop Host input: '+('available' if rescue else 'NOT confirmed; assignment will be refused'))
  return
 epc=runpy.run_path('/usr/local/bin/epc',run_name='input_helpers');epc['host_guard'](json.loads(Path('/etc/elasticpc/runtime.json').read_text()));RUN.mkdir(exist_ok=True)
 lock=os.open(RUN/'input.lock',os.O_CREAT|os.O_RDWR,0o600)
 try:
  fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);path=lease_path(a.guest)
  if a.action=='status':
   if not path.exists():print('No active device lease');return
   lease=json.loads(path.read_text());sock=Path(lease['session'])/'qmp.sock'
   for d in lease['devices']:
    try:d['attached_now']=attachment(epc,sock,d)
    except Exception as e:d['attachment_error']=str(e)
   epc['atomic'](Path(lease['session'])/'device-diagnostics.json',lease)
   print(json.dumps(lease,indent=2,ensure_ascii=False));return
  if a.action=='give':give(epc,json.loads((BASE/(a.guest+'-latest.json')).read_text()),a.devices,a.no_guest_reset);print('USB attachment verified; Guest driver/input still requires testing. Laptop input remains with Host.')
  elif not path.exists():print('No active input lease')
  else:print('External input returned to Host.' if release(epc,json.loads(path.read_text()),a.devices) else 'Deletion pending; run release again. Lease retained.')
 finally:os.close(lock)
if __name__=='__main__':
 try:main()
 except Exception as e:print('REFUSED/FAILED: '+str(e),file=sys.stderr);sys.exit(1)
