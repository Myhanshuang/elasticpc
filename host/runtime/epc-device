def select(devices,names):
 if not names:raise RuntimeError('Specify device names from epc-input list')
 selected=[]
 for name in names:
  exact=[d for d in devices if d.get('name','').casefold()==name.casefold()]
  matches=exact or [d for d in devices if d.get('selector','').casefold()==name.casefold()]
  if len(matches)!=1:
   choices=', '.join(d.get('selector',d['id']) for d in matches)
   raise RuntimeError(('Ambiguous device name; use '+choices) if matches else 'Device name not found: '+name)
  d=matches[0]
  if not d.get('eligible',True):raise RuntimeError(d.get('reason') or 'Device is not eligible')
  if any(x['id']==d['id'] for x in selected):raise RuntimeError('Same device selected twice: '+name)
  selected.append(d)
