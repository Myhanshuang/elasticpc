 except (OSError,ValueError):
  pid=lease.get('pid')
  if not pid:raise RuntimeError('Cannot prove QEMU is gone')
  try:
   cmd=(Path('/proc')/str(pid)/'cmdline').read_bytes()
   if b'qemu-system' in cmd and str(sock).encode() in cmd:raise RuntimeError('QMP unavailable but QEMU alive; no rebind attempted')
  except FileNotFoundError:pass
  ids=set()
 for d in devices:
  if d['id'] in ids and d['id'] not in lease.get('deleting',[]):
   epc['qmp'](sock,'device_del',{'id':d['id']})
   lease.setdefault('deleting',[]).append(d['id']);epc['atomic'](lease_path(lease.get('guest','windows')),lease)
 remaining=peripheral_ids(epc,sock) if ids else set()
 if selected_ids & remaining:return False
 restore_hid(devices)
 lease['devices']=[d for d in lease['devices'] if d['id'] not in selected_ids]
 lease['deleting']=[i for i in lease.get('deleting',[]) if i not in selected_ids]
 if lease['devices']:epc['atomic'](lease_path(lease.get('guest','windows')),lease)
 else:(lease_path(lease.get('guest','windows'))).unlink(missing_ok=True)
