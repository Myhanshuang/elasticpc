  if ':' in p.name or p.name.startswith('usb'):continue
  vid,pid=read(p/'idVendor'),read(p/'idProduct')
  if not vid or not pid:continue
  interfaces=list((SYS/'bus/usb/devices').glob(p.name+':*'))
  classes=[read(i/'bInterfaceClass') for i in interfaces]
  eligible=bool(classes) and all(c in ('01','03') for c in classes)
  name=read(p/'product') or (vid+':'+pid)
  identity=p.name+':'+vid+':'+pid+':'+(read(p/'serial') or '')
  result.append({'id':'epc-input-'+hashlib.sha256(identity.encode()).hexdigest()[:16],
   'kind':'usb-audio' if '01' in classes else 'usb-hid','interface_classes':classes,
   'name':name,'selector':name+'@'+p.name,'eligible':eligible,
   'reason':None if eligible else 'Only USB HID/audio interfaces are supported; storage, hubs, cameras and Bluetooth stay with Host',
   'port':p.name,'vid':vid,'product_id':pid,'serial':read(p/'serial'),
   'hostbus':int(read(p/'busnum')),'hostaddr':int(read(p/'devnum')),
   'interfaces':[i.name for i in interfaces],
   'interface_drivers':{i.name:(i/'driver').resolve().name if (i/'driver').exists() else None for i in interfaces}})
