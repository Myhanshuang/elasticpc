#!/usr/bin/env python3
"""Explicit read-only Host diagnostics; only the requested report directory is written."""
import argparse,json,os,subprocess,time
from pathlib import Path

def main():
 p=argparse.ArgumentParser(description='Collect bounded boot/memory/network diagnostics without changing services or disks.')
 p.add_argument('--output',type=Path,default=Path('/run/elasticpc-diagnostics'))
 a=p.parse_args();out=a.output.resolve();out.mkdir(mode=0o700,parents=True,exist_ok=False)
 commands={
 'boot-time':['systemd-analyze','time'],
 'boot-blame':['systemd-analyze','blame','--no-pager'],
 'boot-chain':['systemd-analyze','critical-chain','--no-pager'],
 'failed-services':['systemctl','--failed','--no-pager'],
 'memory':['free','-h'],
 'process-memory':['ps','-eo','pid,comm,rss','--sort=-rss'],
 'swap':['swapon','--show','--bytes'],
 'mounts':['findmnt','-o','TARGET,SOURCE,FSTYPE,OPTIONS'],
 'disks':['lsblk','-o','NAME,MODEL,SIZE,TRAN,FSTYPE,MOUNTPOINTS'],
 'network-devices':['nmcli','device','status'],
 'ipv4-routes':['ip','-4','route'],
 'ipv6-routes':['ip','-6','route'],
 'boot-warnings':['journalctl','-b','-p','warning','-n','150','--no-pager'],
 'kernel-tail':['journalctl','-k','-b','-n','200','--no-pager'],
 'host-service':['systemctl','status','elasticpc-host','--no-pager'],
 }
 summary={'schema_version':1,'collected_at_unix':time.time(),'commands':{},'note':'May contain local addresses and device identifiers; no credentials or environment dumped.'}
 for name,cmd in commands.items():
  try:
   r=subprocess.run(cmd,capture_output=True,text=True,timeout=20,env={**os.environ,'SYSTEMD_PAGER':'cat','LC_ALL':'C'})
   text=r.stdout+r.stderr
   if name in ('boot-blame','process-memory'):text='\n'.join(text.splitlines()[:50])+'\n'
   (out/(name+'.txt')).write_text(text[:131072]);summary['commands'][name]={'returncode':r.returncode}
  except (OSError,subprocess.TimeoutExpired) as e:summary['commands'][name]={'error':str(e)}
 for name in ['memory','io','cpu']:
  path=Path('/proc/pressure')/name
  if path.exists():(out/('pressure-'+name+'.txt')).write_text(path.read_text())
 (out/'meminfo.txt').write_text(Path('/proc/meminfo').read_text())
 (out/'summary.json').write_text(json.dumps(summary,indent=2)+'\n')
 print('Report saved to '+str(out)+'. Copy it to persistent storage before shutdown; /run is temporary.')
if __name__=='__main__':main()
